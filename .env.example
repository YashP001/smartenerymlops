# Copy to .env to override defaults. Never commit .env (it is git-ignored).
# Change a HOST port here if something else already uses it; container ports
# and service-to-service URLs do not change.

API_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
MLFLOW_PORT=5000

# Change this for any stack that is reachable by other people.
GRAFANA_ADMIN_PASSWORD=admin

# Monitoring worker cadence and the input shift held during degradation.
MONITOR_INTERVAL_SECONDS=10
MONITOR_DEGRADATION_INPUT=sensor_drift
